rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == uid; }
  function dateString(d) { return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
  function monthString(d) { return d is string && d.matches('^[0-9]{4}-[0-9]{2}$'); }
  function money(v) { return v is int && v >= 0 && v <= 1000000000000; }
  function named(d) { return d.name is string && d.name.size() > 0 && d.name.size() <= 100; }
  function account(uid,id) { return id is string && id.size() > 0 && exists(/databases/$(database)/documents/finance_v2/$(uid)/accounts/$(id)); }
  function card(uid,id) { return id is string && id.size() > 0 && exists(/databases/$(database)/documents/finance_v2/$(uid)/cards/$(id)); }
  function category(uid,id) { return id is string && id.size() > 0 && exists(/databases/$(database)/documents/finance_v2/$(uid)/categories/$(id)); }
  function validAccount(d) { return d.keys().hasAll(['name','kind','openingCents','openingDate']) && d.keys().hasOnly(['name','kind','openingCents','openingDate']) && named(d) && d.kind in ['checking','cash','saving','investment'] && d.openingCents is int && d.openingCents >= -1000000000000 && d.openingCents <= 1000000000000 && dateString(d.openingDate); }
  function validCard(d) { return d.keys().hasAll(['name','closingDay','dueDay','limitCents']) && d.keys().hasOnly(['name','closingDay','dueDay','limitCents']) && named(d) && d.closingDay is int && d.closingDay >= 1 && d.closingDay <= 31 && d.dueDay is int && d.dueDay >= 1 && d.dueDay <= 31 && money(d.limitCents); }
  function validBudget(uid,d) { return d.keys().hasAll(['month','category','limitCents']) && d.keys().hasOnly(['month','category','limitCents']) && monthString(d.month) && category(uid,d.category) && money(d.limitCents) && d.limitCents > 0; }
  function validGoal(d) { return d.keys().hasAll(['name','targetCents','savedCents','deadline']) && d.keys().hasOnly(['name','targetCents','savedCents','deadline']) && named(d) && money(d.targetCents) && d.targetCents > 0 && money(d.savedCents) && dateString(d.deadline); }
  function validTransaction(uid,d) {
   return d.keys().hasAll(['kind','description','amountCents','category','accountId','toAccountId','cardId','date','dueDate','competence','paidDate','status','groupId','installment','installments'])
    && d.keys().hasOnly(['kind','description','amountCents','category','accountId','toAccountId','cardId','date','dueDate','competence','paidDate','status','groupId','installment','installments'])
    && d.kind in ['income','expense','card','invoicePayment','transfer','yield']
    && d.status in ['planned','posted','cancelled'] && d.description is string && d.description.size() > 0 && d.description.size() <= 200
    && money(d.amountCents) && d.amountCents > 0 && dateString(d.date) && dateString(d.dueDate) && monthString(d.competence)
    && d.category is string && d.accountId is string && d.toAccountId is string && d.cardId is string
    && d.groupId is string && d.groupId.size() <= 100
    && d.installment is int && d.installments is int && d.installment >= 1 && d.installment <= d.installments && d.installments <= 120
    && ((d.status == 'posted' && d.kind != 'card' && dateString(d.paidDate)) || ((d.status != 'posted' || d.kind == 'card') && d.paidDate is string && (d.paidDate == '' || dateString(d.paidDate))))
    && ((d.kind == 'card' && d.accountId == '') || (d.kind != 'card' && account(uid,d.accountId)))
    && ((d.kind == 'transfer' && account(uid,d.toAccountId) && d.accountId != d.toAccountId) || (d.kind != 'transfer' && d.toAccountId == ''))
    && ((d.kind in ['card','invoicePayment'] && card(uid,d.cardId) && d.status != 'planned') || (!(d.kind in ['card','invoicePayment']) && d.cardId == ''))
    && ((d.kind in ['income','expense','card','yield'] && category(uid,d.category)) || (d.kind in ['invoicePayment','transfer'] && d.category == ''));
  }
  match /finance_v2/{uid}/{kind}/{id} {
   allow read: if owner(uid) && kind in ['accounts','cards','categories','transactions','budgets','goals'];
   allow create, update: if owner(uid) && ((kind == 'accounts' && validAccount(request.resource.data)) || (kind == 'cards' && validCard(request.resource.data)) || (kind == 'categories' && request.resource.data.keys().hasOnly(['name']) && named(request.resource.data)) || (kind == 'transactions' && validTransaction(uid,request.resource.data)) || (kind == 'budgets' && validBudget(uid,request.resource.data)) || (kind == 'goals' && validGoal(request.resource.data)));
   allow delete: if false;
  }
  // Old data remains readable only by its owner; the new app does not use it.
  match /transactions/{id} {
   allow read: if request.auth != null && resource.data.user_id == request.auth.uid;
   allow write: if false;
  }
 }
}
